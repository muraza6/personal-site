@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Extensions
@if (Model != null)
{
    var root = Model.Root();
    var navItems = root.Children
        .Where(x => x.IsVisible() && !x.Value<bool>("umbNaviHide") && x.ContentType.Alias != "projectItem")
        .ToList();
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var availableCultures = new[] { "de", "en-US", "fr-FR" };
    var isLoggedIn = User?.Identity?.IsAuthenticated == true;
    var currentMemberName = User?.Identity?.Name ?? "";

    var loginUrl = Url.Action("Login", "Member", new { area = "Umbraco" });
    var logoutUrl = Url.Action("Logout", "Member", new { area = "Umbraco" });

    <a href="@root.Url()" class="site-logo">
        <span class="logo-text">@root.Name</span>
    </a>
    <nav class="site-nav">
        @foreach (var item in navItems)
        {
            <a href="@item.Url()" class="nav-link @(Model.IsAncestorOrSelf(item) ? "active" : "")">@item.Name</a>
        }
    </nav>

    <div class="login-status">
        @if (isLoggedIn)
        {
            <span class="login-status__label">Welcome, @currentMemberName</span>
            <a href="@logoutUrl" class="login-status__link">Logout</a>
        }
        else
        {
            <a href="@loginUrl" class="login-status__link">Login</a>
        }
    </div>

    @* Language Switcher *@
    @if (availableCultures.Length > 1)
    {
        <div class="language-switcher-wrapper">
            <ul class="language-switcher" aria-label="Language selection">
                @foreach (var culture in availableCultures)
                {
                    var langCode = culture.Split('-')[0].ToUpper();
                    var langFlag = culture.StartsWith("de", StringComparison.OrdinalIgnoreCase) ? "🇩🇪"
                        : culture.StartsWith("fr", StringComparison.OrdinalIgnoreCase) ? "🇫🇷"
                        : "🇬🇧";
                    var langTitle = culture.StartsWith("de", StringComparison.OrdinalIgnoreCase) ? "Deutsch"
                        : culture.StartsWith("fr", StringComparison.OrdinalIgnoreCase) ? "Français"
                        : "English";
                    var langUrl = Model.Url(culture, UrlMode.Relative);
                    var isCurrentLang = currentCulture.Equals(culture, StringComparison.OrdinalIgnoreCase) ||
                                        (currentCulture.StartsWith(culture.Split('-')[0], StringComparison.OrdinalIgnoreCase));
                    <li class="language-item">
                        @if (isCurrentLang)
                        {
                            <span class="lang-link active" aria-current="language" title="@langTitle">
                                <span class="lang-flag">@langFlag</span>
                                <span class="lang-code">@langCode</span>
                            </span>
                        }
                        else
                        {
                            <a href="@langUrl" class="lang-link" hreflang="@culture" lang="@culture" title="Switch to @langTitle">
                                <span class="lang-flag">@langFlag</span>
                                <span class="lang-code">@langCode</span>
                            </a>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <button class="nav-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
    </button>
}
