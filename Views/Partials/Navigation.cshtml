@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Extensions
@if (Model != null)
{
    var root = Model.Root();
    var navItems = root.Children.Where(x => x.IsVisible() && x.ContentType.Alias != "projectItem").ToList();
    <a href="@root.Url()" class="site-logo">
        <span class="logo-text">@root.Name</span>
    </a>
    <nav class="site-nav">
        @foreach (var item in navItems)
        {
            <a href="@item.Url()" class="nav-link @(Model.IsAncestorOrSelf(item) ? "active" : "")">@item.Name</a>
        }
    </nav>
    <button class="nav-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
    </button>
}
